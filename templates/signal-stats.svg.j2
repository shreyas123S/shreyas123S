{# signal-stats.svg.j2 — compact stat row: streak · repos · followers #}
<svg width="700" height="50" viewBox="0 0 700 50" xmlns="http://www.w3.org/2000/svg">
  <style>
    .ss-bg      { fill: #0d1117; }
    .ss-border  { stroke: #30363d; stroke-width: 1; fill: none; }
    .ss-label   { font-family: 'JetBrains Mono', 'Courier New', monospace; font-size: 10px; fill: #8b949e; text-transform: uppercase; letter-spacing: 0.5px; }
    .ss-value   { font-family: 'JetBrains Mono', 'Courier New', monospace; font-size: 14px; fill: #c9d1d9; font-weight: 700; }
    .ss-accent  { fill: #e3b341; }
    .ss-sep     { stroke: #30363d; stroke-width: 1; opacity: 0.4; }

    @media (prefers-color-scheme: light) {
      .ss-bg      { fill: #ffffff; }
      .ss-border  { stroke: #d0d7de; }
      .ss-label   { fill: #57606a; }
      .ss-value   { fill: #1f2328; }
      .ss-accent  { fill: #9a6700; }
      .ss-sep     { stroke: #d0d7de; }
    }
  </style>

  <!-- Background -->
  <rect width="700" height="50" rx="0" class="ss-bg"/>
  <rect x="0.5" y="0.5" width="699" height="49" rx="0" class="ss-border"/>

  <!-- Stats row — up to 3 values, with separators -->
  {% set stats = [] %}
  {% if streak is not none %}{% set _ = stats.append({"label": "streak", "value": streak ~ "d", "accent": true}) %}{% endif %}
  {% if repos is not none %}{% set _ = stats.append({"label": "repos", "value": repos}) %}{% endif %}
  {% if followers is not none %}{% set _ = stats.append({"label": "followers", "value": followers}) %}{% endif %}

  {% set col_width = 652 // (stats|length if stats|length > 0 else 1) %}
  {% for stat in stats %}
  {% set cx = 24 + loop.index0 * col_width + col_width // 2 %}
  <text x="{{ cx }}" y="20" text-anchor="middle" class="ss-label">{{ stat.label }}</text>
  <text x="{{ cx }}" y="40" text-anchor="middle" class="ss-value{% if stat.accent %} ss-accent{% endif %}">{{ stat.value }}</text>
  {% if not loop.last %}
  <line x1="{{ 24 + (loop.index0 + 1) * col_width }}" y1="10" x2="{{ 24 + (loop.index0 + 1) * col_width }}" y2="42" class="ss-sep"/>
  {% endif %}
  {% endfor %}
</svg>
